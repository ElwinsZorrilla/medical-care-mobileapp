# Normalizacion por defecto.
* text=auto eol=lf

# Los scripts corren en Linux (hooks de git, docker build --target verify).
# Con CRLF el shebang queda "#!/usr/bin/env bash\r" y falla con
# "bad interpreter: No such file or directory". Deben ser LF siempre.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Gradle wrapper y scripts nativos de Android/iOS.
gradlew         text eol=lf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binarios: sin normalizar ni diff textual.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.jks           binary
*.keystore      binary
*.apk           binary
*.aab           binary

# Generados: no ensucian el diff de una revision.
*.g.dart        linguist-generated=true
*.freezed.dart  linguist-generated=true
pubspec.lock    -diff
